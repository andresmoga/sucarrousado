{
  "name": "@tcu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/migrate.js && node dist/server.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "seed:prod": "node --env-file-if-exists=../../.env dist/seed.js",
    "start:dev-env": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.8",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tcu/shared": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
