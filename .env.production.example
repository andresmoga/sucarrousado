# ════════════════════════════════════════════════════════════════════════════
# Producción de Carro Usado (sucarrousado.com). Copie a .env.production (Docker)
# o pegue cada variable en el panel del hosting (Render: Environment).
# Si falta una obligatoria, el servidor no arranca y dice cuál falta.
# OJO: en archivos .env, un valor con # o espacios va entre comillas dobles.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=8080

# ── Base de datos (obligatoria). Render la llena sola con el Blueprint. ──
DATABASE_URL=postgres://usuario:clave@host:5432/carrousado

# ── Seguridad (obligatorias). Genere cada una con: openssl rand -hex 32 ──
AUTH_SECRET=
# No la cambie después de lanzar: las placas guardadas dejan de coincidir.
PLATE_HASH_SALT=

# ── Sitio ──
PUBLIC_URL=https://sucarrousado.com
# beta (etiqueta BETA y aviso) o publico
SITE_MODE=beta
# Si se define, solo publican quienes tengan este código (comprar no lo requiere). Vacío = todos publican.
BETA_INVITE_CODE=
# Solo si la web se sirve desde otro dominio que la API (no es el caso con este Docker).
WEB_ORIGIN=

# ── Fotos y videos: Cloudflare R2 (o S3) — obligatorio ──
STORAGE_DRIVER=s3
S3_BUCKET=carrousado-fotos
# R2: https://<ID_DE_CUENTA>.r2.cloudflarestorage.com   (AWS S3: déjelo vacío)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dirección pública del bucket: dominio propio (recomendado) o el r2.dev que da Cloudflare
S3_PUBLIC_URL=https://fotos.sucarrousado.com

# ── Datos del vehículo por placa ──
# none: el vendedor escribe el carro (por defecto hasta tener contrato) · verifik: Fasecolda/RUNT
VEHICLE_DATA_PROVIDER=none
VERIFIK_API_TOKEN=

# ── IA (muy recomendada): reconocer el carro, revisar fotos, redactar y chat ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Video para redes al publicar (necesita ffmpeg; la imagen Docker lo trae) ──
VIDEO_AUTO=1

# ── Responsable de los datos personales (obligatorias; salen en la política y los términos) ──
LEGAL_NAME="Nombre o razón social"
LEGAL_ID="NIT o C.C."
LEGAL_EMAIL=datos@sucarrousado.com
LEGAL_ADDRESS="Dirección completa"
LEGAL_CITY=Chía
LEGAL_PHONE=

# ── Solo docker-compose.prod.yml (servidor propio) ──
POSTGRES_PASSWORD=
SITE_DOMAIN=sucarrousado.com
