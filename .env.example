# ───── API ─────
PORT=4000
DATABASE_URL=postgres://tcu:tcu@localhost:5432/tucarrousado
# Firma de las sesiones. OBLIGATORIO en producción (cadena larga y aleatoria).
AUTH_SECRET=cambie-esto-por-una-cadena-larga
# Sal para guardar la placa como hash (Ley 1581 de 2012)
PLATE_HASH_SALT=cambie-esto
# Dominios que pueden llamar la API (separados por coma). Vacío = todos (solo desarrollo).
WEB_ORIGIN=https://sucarrousado.com,https://www.sucarrousado.com
# Fotos y videos: local (carpeta UPLOAD_DIR, por defecto apps/api/uploads) o s3 (R2/S3, ver .env.production.example)
STORAGE_DRIVER=local
UPLOAD_DIR=

# Proveedor de datos Fasecolda/RUNT: "mock" (desarrollo, placas de prueba), "none" o "verifik"
VEHICLE_DATA_PROVIDER=mock
VERIFIK_API_TOKEN=

# IA (opcional): reconocer el carro en las fotos, redactar el aviso y editarlo por chat.
# Sin clave el sitio funciona en "modo demostración" (confirmación manual y chat con reglas simples).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Dirección pública del sitio, para los enlaces que se comparten en redes
PUBLIC_URL=https://sucarrousado.com
# Video para redes al publicar (requiere ffmpeg con libx264). 0 = desactivado.
VIDEO_AUTO=1
# Fuentes del video (por defecto apps/api/assets/fonts)
FONT_DIR=

# Pruebas de integración (base vacía y desechable)
TEST_DATABASE_URL=postgres://tcu:tcu@localhost:5432/tcu_test

# Sitio (en desarrollo no son obligatorias; en producción sí, ver .env.production.example)
SITE_MODE=beta
BETA_INVITE_CODE=
LEGAL_NAME=
LEGAL_ID=
LEGAL_EMAIL=
LEGAL_ADDRESS=
LEGAL_CITY=

# ───── Web ─────
# Vacío = mismo dominio que la API (recomendado detrás de un proxy).
VITE_API_URL=
# Solo desarrollo: a dónde reenvía Vite /api y /uploads
API_PROXY_TARGET=http://localhost:4000
